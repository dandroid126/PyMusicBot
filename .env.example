# Copy to .env and fill in. Never share or commit .env: the token controls your bot.
# Write values without quotes. See docs/deployment.md.

# Bot token from https://discord.com/developers/applications -> your app -> Bot.
DISCORD_TOKEN=

# Optional: the bot owner's Discord user ID. Defaults to the application's owner.
# OWNER_ID=

# Optional: the folder with your music library, e.g. /srv/music or D:/Music (on Windows, use
# forward slashes). In Docker it's mounted read-only at /music. Default: the music folder here.
# MUSIC_DIR=/path/to/music
